{
  "name": "flowinger",
  "version": "0.1.0",
  "description": "Bespoke, lightweight, and dependency-free React node graph renderer",
  "keywords": [
    "react",
    "node-graph",
    "flow",
    "diagram",
    "graph",
    "svg",
    "react-flow"
  ],
  "homepage": "https://github.com/Naveen-Boddepalli/flowinger#readme",
  "bugs": {
    "url": "https://github.com/Naveen-Boddepalli/flowinger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naveen-Boddepalli/flowinger.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.1.2",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "size": "node scripts/size.mjs"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
