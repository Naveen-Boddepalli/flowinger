{
  "name": "flowinger",
  "version": "0.4.0",
  "description": "Bespoke, lightweight, and dependency-free React node graph renderer",
  "keywords": [
    "react",
    "node-graph",
    "node-editor",
    "flow",
    "flowchart",
    "diagram",
    "graph",
    "tree",
    "pan-zoom",
    "svg",
    "react-flow",
    "react-flow-alternative",
    "typescript",
    "ssr"
  ],
  "author": "Naveen Boddepalli",
  "homepage": "https://github.com/Naveen-Boddepalli/flowinger#readme",
  "bugs": {
    "url": "https://github.com/Naveen-Boddepalli/flowinger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Naveen-Boddepalli/flowinger.git"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "pnpm@11.1.2",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./history": {
      "import": {
        "types": "./dist/pro/history.d.ts",
        "default": "./dist/pro/history.js"
      },
      "require": {
        "types": "./dist/cjs/pro/history.d.ts",
        "default": "./dist/pro/history.cjs"
      }
    },
    "./clipboard": {
      "import": {
        "types": "./dist/pro/clipboard.d.ts",
        "default": "./dist/pro/clipboard.js"
      },
      "require": {
        "types": "./dist/cjs/pro/clipboard.d.ts",
        "default": "./dist/pro/clipboard.cjs"
      }
    },
    "./snaplines": {
      "import": {
        "types": "./dist/pro/snaplines.d.ts",
        "default": "./dist/pro/snaplines.js"
      },
      "require": {
        "types": "./dist/cjs/pro/snaplines.d.ts",
        "default": "./dist/pro/snaplines.cjs"
      }
    },
    "./export": {
      "import": {
        "types": "./dist/pro/export.d.ts",
        "default": "./dist/pro/export.js"
      },
      "require": {
        "types": "./dist/cjs/pro/export.d.ts",
        "default": "./dist/pro/export.cjs"
      }
    },
    "./pro": {
      "import": {
        "types": "./dist/pro/index.d.ts",
        "default": "./dist/pro/index.js"
      },
      "require": {
        "types": "./dist/cjs/pro/index.d.ts",
        "default": "./dist/pro/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "history": ["dist/pro/history.d.ts"],
      "clipboard": ["dist/pro/clipboard.d.ts"],
      "snaplines": ["dist/pro/snaplines.d.ts"],
      "export": ["dist/pro/export.d.ts"],
      "pro": ["dist/pro/index.d.ts"]
    }
  },
  "files": [
    "dist",
    "NOTICE.md",
    "history",
    "clipboard",
    "snaplines",
    "export",
    "pro"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/cjs-types.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "size": "node scripts/size.mjs",
    "check:package": "publint --strict && attw --pack .",
    "demo:build": "vite build --config vite.demo.config.ts",
    "check:examples": "node scripts/check-examples.mjs",
    "e2e": "playwright test"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@xyflow/react": "12.11.6",
    "jsdom": "^30.0.1",
    "publint": "^0.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "typescript-js-api": "npm:typescript@^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
